
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}


model User{
  id Int @id @default(autoincrement()) 
  email String @unique 
  password String
}

enum InvoiceStatus {
  PAID
  UNPAID
}

model Invoice {  
  invoiceNumber Int @id @default(autoincrement()) 
  customerName String 
  amount Float 
  date DateTime 
  status InvoiceStatus 
  createdAt DateTime @default(now()) 
  }